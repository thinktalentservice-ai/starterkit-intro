{
  "name": "@devopsnext/starterkit-intro",
  "version": "0.1.0",
  "description": "JSON-driven, per-page guided intro (product tour) for any React app. Router-agnostic, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "bin",
    "styles.css",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "starterkit-intro": "bin/starterkit-intro.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinktalentservice-ai/starterkit-intro.git"
  },
  "scripts": {
    "build": "tsc --noEmit && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "demo": "vite",
    "storybook": "storybook dev -p 6008 --no-open --disable-telemetry",
    "build-storybook": "storybook build -o docs --disable-telemetry && node -e \"require('node:fs').writeFileSync('docs/.nojekyll', '')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc --noEmit -p tsconfig.playwright.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "verify": "pnpm typecheck && pnpm typecheck:browser && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "storybook": "10.5.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "intro",
    "tour",
    "product-tour",
    "onboarding",
    "guided-tour",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  }
}
